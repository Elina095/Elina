import math


class Circle:

  def __init__(self, radius):
    self.radius = radius

  def area(self):
    return math.pi * self.radius**2


class Square:

  def __init__(self, side):
    self.side = side

  def area(self):
    return self.side**2


class Triangle:

  def __init__(self, base, height):
    self.base = base
    self.height = height

  def area(self):
    return 0.5 * self.base * self.height


def total_area(shapes):
  return sum(shape.area() for shape in shapes)
  # Создаем список, содержащий разные геометрические фигуры вперемешку
shapes_list = [
    Circle(5),  # Круг с радиусом 5
    Square(4),  # Квадрат со стороной 4
    Triangle(6, 10),  # Треугольник с основанием 6 и высотой 10
]

# Считаем суммарную площадь
result = total_area(shapes_list)

print(f"Общая площадь всех фигур: {result:.2f}")