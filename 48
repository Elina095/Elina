class OnlineOrder:

  def __init__(self, amount):
    self.amount = amount

  def calculate_total(self):
    return self.amount


class StoreOrder:

  def __init__(self, amount, delivery_fee):
    self.amount = amount
    self.delivery_fee = delivery_fee

  def calculate_total(self):
    return self.amount + self.delivery_fee


def sum_orders(orders):
  return sum(order.calculate_total() for order in orders)
  
 # Создаем список разнородных заказов
cart = [
    OnlineOrder(3000),  # Интернет-заказ на 3000 тг.
    StoreOrder(1500, 300),  # Заказ из магазина на 1500 тг. + 300 тг. доставка
    OnlineOrder(5400),  # Интернет-заказ на 5400 тг.
]

# Вызываем общую функцию подсчета
total_revenue = sum_orders(cart)

print(f"Общая сумма всех заказов: {total_revenue} тг.")