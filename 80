class Date:

  def __init__(self, day, month, year):
    self.day = day
    self.month = month
    self.year = year

  @staticmethod
  def is_leap_year(year):
    # Год високосный, если он кратен 4, но не кратен 100, либо кратен 400
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)


# Пример использования (вызов без создания объекта):
print(Date.is_leap_year(2024))  # True
print(Date.is_leap_year(2023))  # False