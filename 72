class Book:

  def __init__(self, title, author, pages):
    self.title = title
    self.author = author
    self.pages = pages  # Количество страниц

  # Магический метод __len__ позволяет использовать встроенную функцию len()
  def __len__(self):
    return self.pages

  def __str__(self):
    return f"Книга '{self.title}' автора {self.author} ({self.pages} стр.)"



my_book = Book("Война и мир", "Лев Толстой", 1300)

print(my_book)  

# Используем стандартную функцию len() на пользовательском объекте
book_length = len(my_book)
print(
    f"Количество страниц в книге через : {book_length}")